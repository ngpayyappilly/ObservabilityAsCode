# Log-derived metric: counts ERROR-level log events for this service.
# Uses DQL to filter by Kubernetes namespace and log level.
# Split by error.type for cardinality-safe aggregation (bounded dimension).
# Dynatrace builtin:log.metrics type.

configs:
  - id: {{ service_name }}-log-metric-errors
    type:
      settings:
        schema: builtin:log.metrics
        scope: environment
    config:
      name: "{{ service_name }} Error Log Count"
      template: {}    # settings API uses inline config, not a separate JSON file
      skip: false

# Inline settings config (Monaco v2 settings schema style)
---
configs:
  - id: {{ service_name }}-log-metric-errors
    type:
      settings:
        schema: builtin:log.metrics
        scope: environment
    config:
      name: "log.{{ service_name }}.errors"
      template:
        metricKey: "log.{{ service_name }}.errors"
        displayName: "{{ service_name }} Error Log Count"
        active: true
        query: |
          fetch logs
          | filter k8s.namespace.name == "{{ service_name }}"
          | filter level == "ERROR"
          | summarize count = count(), by: bin(timestamp, 1m), error.type
        dimensions:
          - name: "error.type"
            type: "ATTRIBUTE"
            attribute: "error.type"
            topX: 50            # cardinality cap — only top-50 error.type values
        unit: "COUNT"
