# Monaco v2 project manifest for service: {{ service_name }}
# Generated by observability-template scaffold — do not edit by hand.
# Re-scaffold via the bootstrap pipeline in the observability-template repo.

manifestVersion: "1.0"

projects:
  - name: {{ service_name }}
    path: "configs"     # actual Monaco config tree — keeps environments/ and
                         # slos/endpoints/critical-endpoints.yaml (script inputs,
                         # not Monaco configs) out of the scanned project path
    type: simple

environmentGroups:
  - name: all-envs
    environments:
      - name: dev
        url:
          type: environment
          value: DT_DEV_URL          # injected by ArgoCD CMP sidecar from ExternalSecret
        auth:
          token:
            type: environment
            name: DT_DEV_TOKEN

      - name: staging
        url:
          type: environment
          value: DT_STAGING_URL
        auth:
          token:
            type: environment
            name: DT_STAGING_TOKEN

      - name: perf
        url:
          type: environment
          value: DT_PERF_URL
        auth:
          token:
            type: environment
            name: DT_PERF_TOKEN

      - name: prod
        url:
          type: environment
          value: DT_PROD_URL
        auth:
          token:
            type: environment
            name: DT_PROD_TOKEN
