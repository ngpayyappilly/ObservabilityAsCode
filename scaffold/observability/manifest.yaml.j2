# Monaco v2 project manifest for service: {{ service_name }}
# Generated by observability-template scaffold — do not edit by hand.
# Re-scaffold via the bootstrap pipeline in the observability-template repo.

manifestVersion: "2.0"

projects:
  - name: {{ service_name }}
    path: "."          # all configs in this directory tree — includes slos/endpoints/generated/
    type: simple

environmentGroups:
  - name: all-envs
    environments:
      - dev
      - staging
      - perf
      - prod

environments:
  dev:
    name: dev
    url:
      type: environment
      value: DT_DEV_URL          # injected by ArgoCD CMP sidecar from ExternalSecret
    auth:
      token:
        type: environment
        value: DT_DEV_TOKEN

  staging:
    name: staging
    url:
      type: environment
      value: DT_STAGING_URL
    auth:
      token:
        type: environment
        value: DT_STAGING_TOKEN

  perf:
    name: perf
    url:
      type: environment
      value: DT_PERF_URL
    auth:
      token:
        type: environment
        value: DT_PERF_TOKEN

  prod:
    name: prod
    url:
      type: environment
      value: DT_PROD_URL
    auth:
      token:
        type: environment
        value: DT_PROD_TOKEN
